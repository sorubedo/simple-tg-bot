{
  telegram: {
    // 推荐用 BOTTG_TOKEN 环境变量提供 token，避免把密钥写进文件。
    // 两边都提供时，环境变量优先。
    token: "",

    // 目标超级群组的数字 ID，必须是负数（通常形如 -1001234567890）。
    // 如果要接收普通消息，请把 bot 设为群管理员，或在 BotFather 关闭 privacy mode。
    // 仅开启 privacy mode 且不是管理员时，bot 只会收到命令、提及和回复。
    group_id: -1001234567890,
  },

  polling: {
    // getUpdates 长轮询等待时间，单位秒。
    timeout_seconds: 30,

    // 两次轮询之间的额外间隔，0 表示不额外等待。
    poll_interval: 0.0,

    // 启动时是否丢弃 Telegram 服务器上积压的更新。
    drop_pending_updates: false,

    // null 表示使用 Telegram 默认更新集合（实际发送空数组，包含 message）；
    // 也可显式写成 ["message", "edited_message"]。
    // bottg 总会显式发送该参数，避免继承上一次运行或其他工具留下的旧设置。
    // 如果外挂程序订阅了 message / edited_message 钩子，显式数组里必须包含对应类型。
    allowed_updates: null,

    // 内存中最多缓存多少个尚未处理的更新。
    // 队列满时长轮询会等待，未确认的更新留在 Telegram 服务器上，避免内存无限增长。
    // 0 表示不限制（不建议）。
    max_pending_updates: 100,
  },

  runtime: {
    // stdout 日志等级：DEBUG / INFO / WARNING / ERROR / CRITICAL
    log_level: "INFO",

    // 同步到目标群组 #General 话题的日志等级。
    // 设置为 null 或 "OFF" 可关闭 Telegram 日志通道。
    telegram_log_level: "INFO",
  },

  // 动作队列：外部程序 stdout 返回的动作在这里串行执行。
  actions: {
    // 最多排队多少个“动作组”。0 不允许；队列满时生产者等待。
    max_pending: 100,

    // 生产者最多等待多少秒让动作组入队，超时则整组丢弃并记录错误。
    enqueue_timeout_seconds: 10,

    // 关闭时最多等待多少秒把队列执行完，超时则取消当前动作并丢弃剩余动作。
    drain_timeout_seconds: 30,

    // 两次 Telegram 动作之间的最小间隔，用于主动降低触发限流的概率。
    // 0 表示不额外等待；遇到 RetryAfter 时队列仍会自动等待并重试。
    min_interval_seconds: 0.0,
  },

  // 外挂程序：每个程序通过 stdin 收到钩子事件 JSON，
  // 可以通过 stdout 返回动作 JSON。详细协议见 README。
  // 每个 message 钩子程序都会在每条匹配消息上运行；示例按动作拆分，
  // 生产环境可以合并成一个程序，减少子进程启动次数。
  programs: {
    // 示例：echo / slowecho（发送消息、sleep、edited_message 触发）
    echo: {
      // 不使用 shell；每一项都是一个独立的 argv。
      // 相对 cwd 的路径以配置文件所在目录为基准。
      command: ["python3", "examples/echo_hook.py"],

      // 必填：startup / message / edited_message / shutdown，至少一个。
      hooks: ["message", "edited_message"],

      // 单次执行的超时，单位秒。
      timeout_seconds: 10,

      // 可选：工作目录。默认是配置文件所在目录；相对路径也以配置目录为基准。
      // cwd: "/opt/bottg/hooks",

      // 可选：在继承当前进程环境变量的基础上追加/覆盖。
      // env: { HOOK_MODE: "production" },

      // 仅对 message / edited_message 钩子有效。null 表示所有话题；
      // 数组里的 null 表示 General（没有 message_thread_id）话题。
      message: {
        topics: null,
        // 默认忽略其他 bot 发送的消息，避免机器人之间互相触发。
        ignore_bots: true,
      },

      // stdout 最多保留多少字节，超出视为协议错误。
      max_output_bytes: 65536,
    },

    // 示例：贴表情。
    reaction: {
      command: ["python3", "examples/reaction_hook.py"],
      hooks: ["message"],
      timeout_seconds: 10,
    },

    // 示例：删除消息。
    cleanup: {
      command: ["python3", "examples/cleanup_hook.py"],
      hooks: ["message"],
      timeout_seconds: 10,
    },

    // 示例：创建、改名、删除话题。
    topics: {
      command: ["python3", "examples/topic_hook.py"],
      hooks: ["message"],
      timeout_seconds: 10,
    },

    // 启动/关闭钩子示例：在 General 话题发送一条状态消息。
    lifecycle: {
      command: ["python3", "examples/lifecycle_hook.py"],
      hooks: ["startup", "shutdown"],
      timeout_seconds: 10,
    },
  },
}

{
  telegram: {
    // 推荐用 BOTTG_TOKEN 环境变量提供 token，避免把密钥写进文件。
    // 两边都提供时，环境变量优先。
    token: "",

    // 目标超级群组的数字 ID，必须是负数（通常形如 -1001234567890）。
    group_id: -1001234567890,
  },

  polling: {
    // getUpdates 长轮询等待时间，单位秒。
    timeout_seconds: 30,

    // 两次轮询之间的额外间隔，0 表示不额外等待。
    poll_interval: 0.0,

    // 启动时是否丢弃 Telegram 服务器上积压的更新。
    drop_pending_updates: false,

    // null 表示接收所有更新类型；也可写成 ["message", "callback_query"]。
    allowed_updates: null,

    // 内存中最多缓存多少个尚未处理的更新。
    // 队列满时长轮询会等待，未确认的更新留在 Telegram 服务器上，避免内存无限增长。
    // 0 表示不限制（不建议）。
    max_pending_updates: 100,
  },

  runtime: {
    // stdout 日志等级：DEBUG / INFO / WARNING / ERROR / CRITICAL
    log_level: "INFO",

    // 同步到目标群组 #General 话题的日志等级。
    // 设置为 null 或 "OFF" 可关闭 Telegram 日志通道。
    telegram_log_level: "INFO",
  },

  // 预留给后续版本的“配置驱动外部程序/脚本”能力。
  // 当前版本只解析并保留，不会执行任何外部程序。
  programs: {
    // example: {
    //   command: ["/usr/local/bin/on-message"],
    //   timeout_seconds: 30,
    // },
  },
}
